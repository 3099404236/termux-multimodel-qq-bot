# Store the filled file as /etc/antigravity-flash-gateway.env with mode 0600.
FLASH_GATEWAY_HOST=127.0.0.1
FLASH_GATEWAY_PORT=18046
FLASH_GATEWAY_API_KEY=
FLASH_GATEWAY_TARGET_MODEL=gemini-3.7-flash-high
FLASH_GATEWAY_MAX_BODY_BYTES=16777216
FLASH_GATEWAY_TIMEOUT=600

ANTIGRAVITY_MANAGER_BASE_URL=http://127.0.0.1:8045
ANTIGRAVITY_MANAGER_API_KEY=
